# Renomeie/copie este arquivo para "local.env" e preencha com suas credenciais.

# Senha do usuário root do MySQL
MYSQL_ROOT_PASSWORD=

# Nome do banco de dados
MYSQL_DATABASE=

# Usuário e senha da aplicação (criados no banco acima)
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Credenciais do MongoDB
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# URI de conexão da aplicação com o MongoDB
SPRING_DATA_MONGODB_URI=
